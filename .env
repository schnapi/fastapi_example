# Database
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_HOST_AUTH_METHOD=scram-sha-256
DATABASE_URL=postgresql://postgres:password@db:5432/postgres

# Development flags
ENV=dev
# HOT_RELOAD=true        # container runs Uvicorn with --reload
# DEBUG=false            # debugpy attach; only set to true when debugging in VS Code
SECRET_KEY=devsecret
WEB_CONCURRENCY=2


# OpenObserve & OTel Collector
ZO_ROOT_USER_EMAIL=admin@example.com
ZO_ROOT_USER_PASSWORD=ChangeMe123!
# Generate with: echo -n "admin@example.com:ChangeMe123!" | base64
O2_AUTH_TOKEN=YWRtaW5AZXhhbXBsZS5jb206Q2hhbmdlTWUxMjMh

# FastAPI / OpenTelemetry SDK target
OTEL_SERVICE_NAME=api
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf